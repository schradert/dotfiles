{
  "data": {
    "cloudflare_accounts": {
      "main": {
        "name": "Tristanschrader@proton.me's Account"
      }
    },
    "external": {
      "sops_decrypt": {
        "program": [
          "/nix/store/crs76r1gifq0ay48v4kvws42fc59gmx5-bash-5.2p26/bin/bash",
          "-c",
          "root=\"$(/nix/store/v164ksb5p2cp4hr18nadn1i7zln9p23h-git-2.44.0/bin/git rev-parse --show-toplevel)\"\n/nix/store/la29b8q08v8fycymcync5z570ikwfvlm-sops-3.8.1/bin/sops --config \"$root/.sops.yaml\" --decrypt \"$root/dev/sops/default.yaml\" | /nix/store/1b751xllcmzsfnqmv3k12ggyjwrgi93h-python3.11-yq-3.2.3/bin/yq\n"
        ]
      }
    }
  },
  "provider": {
    "cloudflare": {
      "api_token": "${ data.external.sops_decrypt.result[\"cloudflare_pat\"] }"
    },
    "github": {
      "token": "${ data.external.sops_decrypt.result[\"github_pat\"] }"
    },
    "gitlab": {
      "token": "${ data.external.sops_decrypt.result[\"gitlab_pat\"] }"
    }
  },
  "resource": {
    "cloudflare_record": {
      "base": {
        "name": "@",
        "type": "A",
        "value": "ref+sops://dev/sops/default.yaml#/trdos_ip",
        "zone_id": "${ cloudflare_zone.trdos.id }"
      },
      "www": {
        "name": "www",
        "type": "CNAME",
        "value": "${ cloudflare_zone.trdos.zone }",
        "zone_id": "${ cloudflare_zone.trdos.id }"
      }
    },
    "cloudflare_zone": {
      "trdos": {
        "account_id": "${ data.cloudflare_accounts.main.accounts[0].id }",
        "zone": "trdos.me"
      }
    },
    "github_user_ssh_key": {
      "tristan": {
        "key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAfcKmSKVDQ+jMIP/dSbeG7QwzepO3CdUvXNi2iLhefl\n",
        "title": "dotfiles"
      }
    },
    "gitlab_user_sshkey": {
      "tristan": {
        "key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAfcKmSKVDQ+jMIP/dSbeG7QwzepO3CdUvXNi2iLhefl\n",
        "title": "dotfiles"
      }
    }
  },
  "terraform": {
    "encryption": {
      "key_provider": {
        "pbkdf2": {
          "default": {
            "passphrase": "ref+sops://dev/sops/default.yaml#/opentofu_pw"
          }
        }
      },
      "method": {
        "aes_gcm": {
          "default": {
            "keys": "${ key_provider.pbkdf2.default }"
          }
        }
      },
      "plan": {
        "fallback": {
          "method": "${ method.aes_gcm.default }"
        },
        "method": "${ method.aes_gcm.default }"
      },
      "state": {
        "fallback": {},
        "method": "${ method.aes_gcm.default }"
      }
    },
    "required_providers": {
      "cloudflare": {
        "source": "cloudflare/cloudflare",
        "version": "4.28.0"
      },
      "external": {
        "source": "opentofu/external",
        "version": "2.3.3"
      },
      "github": {
        "source": "integrations/github",
        "version": "6.2.1"
      },
      "gitlab": {
        "source": "gitlabhq/gitlab",
        "version": "16.10.0"
      }
    }
  }
}
