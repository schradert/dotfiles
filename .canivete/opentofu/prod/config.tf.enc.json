{
  "data": {
    "external": {
      "encrypt-kubeconfig": {
        "program": [
          "/nix/store/spyn2n8l9ca1pkqn20l40l424xmqwda4-bash-5.2p26/bin/bash",
          "-c",
          "ssh sirver sudo k3s kubectl config view --raw | sed 's/127.0.0.1/trdos.me/' | \\\n  /nix/store/xfb4mnxhbfn1n8bazy90h3db6xh5s4x1-sops-3.9.0/bin/sops --encrypt --input-type binary --output-type binary /dev/stdin | \\\n  /nix/store/7wd5dn3p6czs3vjkpgadniv8r5jsbg6d-python3.12-yq-3.4.3/bin/yq --raw-input '{\"kubeconfig\":.}'\n"
        ]
      }
    }
  },
  "resource": {
    "local_file": {
      "encrypted-kubeconfig": {
        "content": "${ yamlencode(jsondecode(data.external.encrypt-kubeconfig.result.kubeconfig)) }",
        "filename": "${ path.module }/kubeconfig.enc"
      }
    }
  },
  "terraform": {
    "encryption": {
      "key_provider": {
        "pbkdf2": {
          "default": {
            "passphrase": "ref+sops://.canivete/sops/default.yaml#/opentofu_pw"
          }
        }
      },
      "method": {
        "aes_gcm": {
          "default": {
            "keys": "${ key_provider.pbkdf2.default }"
          }
        }
      },
      "plan": {
        "fallback": {
          "method": "${ method.aes_gcm.default }"
        },
        "method": "${ method.aes_gcm.default }"
      },
      "state": {
        "fallback": {
          "method": "${ method.aes_gcm.default }"
        },
        "method": "${ method.aes_gcm.default }"
      }
    },
    "required_providers": {
      "external": {
        "source": "opentofu/external",
        "version": "2.3.3"
      },
      "local": {
        "source": "opentofu/local",
        "version": "2.5.1"
      }
    }
  }
}
