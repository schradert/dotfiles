{
  "data": {
    "cloudflare_accounts": {
      "main": {
        "name": "Tristanschrader@proton.me's Account"
      }
    }
  },
  "provider": {
    "b2": {
      "application_key": "ref+sops://.canivete/sops/default.yaml#/backblaze/application_key",
      "application_key_id": "ref+sops://.canivete/sops/default.yaml#/backblaze/application_key_id"
    },
    "cloudflare": {
      "api_token": "ref+sops://.canivete/sops/default.yaml#/cloudflare_pat"
    },
    "github": {
      "token": "ref+sops://.canivete/sops/default.yaml#/github_pat"
    },
    "gitlab": {
      "token": "ref+sops://.canivete/sops/default.yaml#/gitlab_pat"
    }
  },
  "resource": {
    "b2_bucket": {
      "main": {
        "bucket_name": "t0rdos",
        "bucket_type": "allPrivate"
      }
    },
    "cloudflare_record": {
      "base": {
        "name": "@",
        "type": "A",
        "value": "ref+sops://.canivete/sops/default.yaml#/trdos_ip",
        "zone_id": "${ cloudflare_zone.trdos.id }"
      },
      "www": {
        "name": "www",
        "type": "CNAME",
        "value": "${ cloudflare_zone.trdos.zone }",
        "zone_id": "${ cloudflare_zone.trdos.id }"
      }
    },
    "cloudflare_zone": {
      "trdos": {
        "account_id": "${ data.cloudflare_accounts.main.accounts[0].id }",
        "zone": "trdos.me"
      }
    },
    "github_user_ssh_key": {
      "tristan": {
        "key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAfcKmSKVDQ+jMIP/dSbeG7QwzepO3CdUvXNi2iLhefl\n",
        "title": "dotfiles"
      }
    },
    "gitlab_user_sshkey": {
      "tristan": {
        "key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAfcKmSKVDQ+jMIP/dSbeG7QwzepO3CdUvXNi2iLhefl\n",
        "title": "dotfiles"
      }
    }
  },
  "terraform": {
    "encryption": {
      "key_provider": {
        "pbkdf2": {
          "default": {
            "passphrase": "ref+sops://.canivete/sops/default.yaml#/opentofu_pw"
          }
        }
      },
      "method": {
        "aes_gcm": {
          "default": {
            "keys": "${ key_provider.pbkdf2.default }"
          }
        }
      },
      "plan": {
        "fallback": {
          "method": "${ method.aes_gcm.default }"
        },
        "method": "${ method.aes_gcm.default }"
      },
      "state": {
        "fallback": {
          "method": "${ method.aes_gcm.default }"
        },
        "method": "${ method.aes_gcm.default }"
      }
    },
    "required_providers": {
      "b2": {
        "source": "Backblaze/b2",
        "version": "0.8.9"
      },
      "cloudflare": {
        "source": "cloudflare/cloudflare",
        "version": "4.28.0"
      },
      "github": {
        "source": "integrations/github",
        "version": "6.2.1"
      },
      "gitlab": {
        "source": "gitlabhq/gitlab",
        "version": "16.10.0"
      }
    }
  }
}
